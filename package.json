{
	"name": "annoteca",
	"version": "1.6.0",
	"description": "Categorized inline feedback comments for long-form markdown documents. Plain HTML storage, threaded AI conversations, readable by humans and any AI assistant. Works on desktop and mobile.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings 0 && node scripts/check-submission.mjs",
		"test": "jest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Charles Kelsoe (ckelsoe)",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.2",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.7",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.1.0",
		"jest": "^30.2.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.0",
		"ts-jest": "^29.4.6",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.1"
	},
	"overrides": {
		"handlebars": "^4.7.9",
		"picomatch": "^2.3.2",
		"flatted": "^3.4.0",
		"ajv": "^6.14.0",
		"brace-expansion@1": "^1.1.13",
		"brace-expansion@2": "^2.0.3",
		"js-yaml": "^4.2.0",
		"@babel/core": "^7.29.6"
	}
}
